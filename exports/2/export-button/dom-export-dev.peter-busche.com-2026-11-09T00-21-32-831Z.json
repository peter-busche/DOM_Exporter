      "text": ":root { color-scheme: light dark; --bg: #fafaf7; --fg: #1c1c1a; --muted: #5f5f5a; --line: #e4e4de; --accent: #0b6e4f; --card: #ffffff; font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; line-height: 1.55; }\n@media (prefers-color-scheme: dark) {\n  :root { --bg: #141412; --fg: #ecebe6; --muted: #a3a29b; --line: #2b2b28; --accent: #4fc79a; --card: #1c1c1a; }\n}\n* { box-sizing: border-box; }\nbody { margin: 0px; background: var(--bg); color: var(--fg); }\na { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; }\n.page { max-width: 56rem; margin: 0px auto; padding: 4rem 1.25rem 6rem; }\n.hero { margin-bottom: 3.5rem; }\n.eyebrow { margin: 0px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; }\nh1 { margin: 0.25rem 0px 1rem; font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.02em; }\nh2 { font-size: 1.25rem; margin: 0px 0px 1rem; }\nh3 { margin: 0px 0px 0.5rem; font-size: 1.05rem; }\n.lede { max-width: 40rem; font-size: 1.1rem; color: var(--muted); }\n.links { display: flex; gap: 1rem; }\n.grid { list-style: none; padding: 0px; margin: 0px; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }\n.card { height: 100%; padding: 1.25rem; background: var(--card); border: 1px solid var(--line); border-radius: 0.75rem; }\n.card p { margin: 0px 0px 1rem; color: var(--muted); font-size: 0.95rem; }\n.repos { list-style: none; padding: 0px; margin: 0px 0px 0.9rem; display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; font-size: 0.9rem; }\n.tags { list-style: none; padding: 0px; margin: 0px; display: flex; flex-wrap: wrap; gap: 0.4rem; }\n.tags li { font-size: 0.75rem; padding: 0.15rem 0.55rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }\n.muted { color: var(--muted); }\n.banner { margin: 0px 0px 1.5rem; padding: 0.6rem 0.9rem; border-left: 3px solid var(--accent); background: var(--card); border-radius: 0.5rem; font-weight: 600; }\n.error { color: rgb(180, 35, 24); }\n.suggest { margin-top: 3.5rem; }\n.form { display: grid; gap: 0.9rem; max-width: 34rem; }\n.form label { display: grid; gap: 0.3rem; font-size: 0.9rem; }\n.form input, .form textarea { font: inherit; padding: 0.5rem 0.65rem; border: 1px solid var(--line); border-radius: 0.5rem; background: var(--card); color: var(--fg); }\nbutton { font: inherit; padding: 0.55rem 1rem; border-radius: 0.5rem; border: 1px solid var(--accent); background: var(--accent); color: rgb(255, 255, 255); cursor: pointer; justify-self: start; }\nbutton:disabled { opacity: 0.6; cursor: default; }\nbutton.link { padding: 0px; border: 0px; background: none; color: var(--accent); text-decoration: underline; }\n.admin-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }\n.list { list-style: none; padding: 0px; margin: 1rem 0px 0px; display: grid; gap: 0.75rem; }\n.list li { padding: 0.75rem 1rem; border: 1px solid var(--line); border-radius: 0.5rem; background: var(--card); }\n.list li p { margin: 0px 0px 0.25rem; }\nsection + section { margin-top: 2.5rem; }\n:root { --series-1: #2a78d6; --viz-grid: #e4e4de; }\n@media (prefers-color-scheme: dark) {\n  :root { --series-1: #3987e5; --viz-grid: #2b2b28; }\n}\n.viz { margin: 1.25rem 0px 0px; }\n.viz-title { font-size: 0.9rem; color: var(--muted); margin-bottom: 0.5rem; }\n.viz-plot { position: relative; }\n.viz-plot svg { display: block; width: 100%; height: auto; }\n.viz-bar { fill: var(--series-1); }\n.viz-bar.is-hover { fill-opacity: 0.75; }\n.viz-grid { stroke: var(--viz-grid); stroke-width: 1; }\n.viz-tick { fill: var(--muted); font-size: 11px; }\n.viz-tooltip { position: absolute; top: 0px; transform: translate(-50%); padding: 0.3rem 0.6rem; background: var(--card); border: 1px solid var(--line); border-radius: 0.4rem; font-size: 0.85rem; white-space: nowrap; pointer-events: none; }\n.viz-table { margin-top: 0.5rem; font-size: 0.85rem; }\n.viz-table summary { cursor: pointer; color: var(--muted); }\n.viz-table table { border-collapse: collapse; margin-top: 0.5rem; }\n.viz-table th, .viz-table td { text-align: right; padding: 0.2rem 0.75rem 0.2rem 0px; border-bottom: 1px solid var(--line); }\n.viz-table th:first-child, .viz-table td:first-child { text-align: left; }\n.tiles { list-style: none; padding: 0px; margin: 1rem 0px 0px; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }\n.tile { padding: 0.75rem 1rem; border: 1px solid var(--line); border-radius: 0.5rem; background: var(--card); display: grid; gap: 0.15rem; }\n.tile-label { font-size: 0.8rem; color: var(--muted); }\n.tile-value { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; }\n.small { font-size: 0.9rem; }\n.project-header { margin-bottom: 2rem; }\n.project-header .repos { margin-bottom: 0.75rem; }\n.markdown { line-height: 1.6; }\n.markdown pre { overflow-x: auto; padding: 0.75rem 1rem; background: var(--card); border: 1px solid var(--line); border-radius: 0.5rem; }\n.markdown code { font-size: 0.9em; }\n.markdown img { max-width: 100%; }\n.markdown table { border-collapse: collapse; }\n.markdown th, .markdown td { border: 1px solid var(--line); padding: 0.3rem 0.6rem; }\n.markdown h1 { font-size: 1.6rem; }\n.markdown h2 { font-size: 1.25rem; margin-top: 2rem; }\n.posts { list-style: none; padding: 0px; margin: 1rem 0px 0px; display: grid; gap: 1.25rem; }\n.posts h3 { margin: 0.1rem 0px 0.35rem; font-size: 1.1rem; }\n.posts p { margin: 0px; }\n.badge { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.1rem 0.45rem; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); vertical-align: middle; }\n.badge.published { border-color: var(--accent); color: var(--accent); }\n.row { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }\n.check { display: flex; gap: 0.5rem; align-items: center; }\n.editor { margin: 1.5rem 0px; padding: 1rem; border: 1px solid var(--line); border-radius: 0.5rem; background: var(--card); max-width: none; }\n.editor textarea, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; }\n.site-header { position: sticky; top: 0px; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 0.25rem 1.25rem; background: var(--card); border-bottom: 1px solid var(--line); }\n.brand { display: inline-flex; align-items: center; font-weight: 700; letter-spacing: -0.01em; color: var(--fg); text-decoration: none; }\n.brand-mark { display: block; height: 3rem; width: auto; }\n.nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }\n.nav a { color: var(--muted); text-decoration: none; padding: 0.25rem 0px; border-bottom: 2px solid transparent; }\n.nav a:hover { color: var(--fg); }\n.nav a.active { color: var(--fg); border-bottom-color: var(--accent); }\n.audience-banner { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 0.5rem 1.25rem; background: color-mix(in srgb,var(--accent) 12%,var(--bg)); border-bottom: 1px solid var(--line); font-weight: 600; }\n.audience-banner button { font-size: 1.1rem; line-height: 1; text-decoration: none; }\n.footer { max-width: 56rem; margin: 0px auto; padding: 2rem 1.25rem 3rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--line); font-size: 0.9rem; }\n.audience-note { margin: 0px 0px 2.5rem; padding: 1rem 1.25rem; border-left: 3px solid var(--accent); background: var(--card); border-radius: 0.5rem; max-width: 44rem; }\n.audience-note p { margin: 0px 0px 0.75rem; }\n.audience-note p:last-child { margin-bottom: 0px; }\n.bio { max-width: 44rem; }\n.link-cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }\n.link-card { display: block; text-decoration: none; color: inherit; }\n.link-card h2 { margin: 0px 0px 0.4rem; font-size: 1.05rem; color: var(--accent); }\n.link-card p { margin: 0px; color: var(--muted); font-size: 0.95rem; }\n.link-card:hover { border-color: var(--accent); }\n.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; }\n.card h3 .badge { margin-left: 0.5rem; }\n.contact li p:last-child { margin: 0px; font-size: 1.05rem; }"
